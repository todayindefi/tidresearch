---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { services, serviceBySlug } from "@/lib/services";

// Paths come from the shared service list, so adding a service adds its page,
// its homepage card, and its footer link together.
export function getStaticPaths() {
  return services.map((s) => ({ params: { kind: s.slug } }));
}

const { kind } = Astro.params;

const c = serviceBySlug[kind!];
if (!c) return Astro.redirect("/404");
const { Icon } = c;

---

<BaseLayout title={`${c.title} | TID Research`} description={c.tagline}>
  <section class="container-page py-20 max-w-3xl">
    <div class="flex items-center gap-4 mb-8">
      <div class="p-4 bg-primary/10 border border-primary/30">
        <Icon className="h-8 w-8 text-primary" />
      </div>
      <p class="eyebrow">Services</p>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">{c.title}</h1>
    <p class="text-xl text-muted-foreground mb-12">{c.tagline}</p>

    <div class="prose-report">
      <h2>What's included</h2>
      <ul>
        {c.bullets.map((b) => <li>{b}</li>)}
      </ul>
    </div>

    {
      kind === "governance" && (
        <div class="mt-12 p-6 border border-border/60 bg-card/40">
          <p class="eyebrow mb-3">Verify our record</p>
          <h2 class="text-xl font-bold mb-2">Arbitrum DAO</h2>
          <p class="text-muted-foreground text-sm leading-relaxed mb-4">
            We have been delegates in the Arbitrum DAO since October 2024, arguing
            positions in public under our own name. Our full posting history is on the
            governance forum — read it before you delegate to anyone.
          </p>
          <a
            href="https://forum.arbitrum.foundation/u/TodayInDeFi/summary"
            class="text-sm uppercase tracking-wider text-primary hover:underline font-semibold font-mono"
            target="_blank"
            rel="noopener noreferrer"
          >
            forum.arbitrum.foundation/u/TodayInDeFi
          </a>
        </div>
      )
    }

    {
      kind === "risk" && (
        <div class="mt-12 p-6 border border-border/60 bg-card/40">
          <p class="eyebrow mb-3">For integration partners</p>
          <h2 class="text-xl font-bold mb-2">Risk Score Feed</h2>
          <p class="text-muted-foreground text-sm leading-relaxed mb-4">
            Every asset and protocol score we maintain is available as structured JSON,
            for teams that want risk scores inside their own systems rather than in a
            PDF. Get in touch to discuss access.
          </p>
          <a
            href="/contact"
            class="text-sm uppercase tracking-wider text-primary hover:underline font-semibold"
          >
            Request feed access
          </a>
        </div>
      )
    }

    <div class="mt-12 flex flex-wrap gap-4">
      <Button href="/contact" size="lg">{c.cta}</Button>
      <Button href="/reports" variant="outline" size="lg">See sample work</Button>
    </div>
  </section>
</BaseLayout>
