---
import { getCollection, render } from "astro:content";
import ReportLayout from "@/layouts/ReportLayout.astro";
import ArchitectureReportLayout from "@/layouts/ArchitectureReportLayout.astro";
import { sectionEnabled, visibleAtCurrentStage } from "@/lib/stage";

export async function getStaticPaths() {
  if (!sectionEnabled("protocols")) return [];

  const protocols = await getCollection("protocols");
  return protocols
    .filter((entry) => visibleAtCurrentStage(entry.data))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const Layout = entry.data.assessment_type === "architecture_review" ? ArchitectureReportLayout : ReportLayout;
---

<Layout data={entry.data} headings={headings}>
  <Content />
</Layout>
