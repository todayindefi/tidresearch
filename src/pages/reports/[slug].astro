---
import { getCollection, render } from "astro:content";
import ReportLayout from "@/layouts/ReportLayout.astro";
import { visibleAtCurrentStage } from "@/lib/stage";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports
    .filter((r) => visibleAtCurrentStage(r.data))
    .map((r) => ({
      params: { slug: r.data.slug },
      props: { entry: r },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Slugs with a live dashboard. Most iframe backing-monitor by slug;
// thBILL has its own standalone dashboard repo referenced via the
// report's live_dashboard_url frontmatter field. Only the institutional
// thBILL page shows the dashboard; the retail summary stays clean.
import {
  hasDashboardEmbed,
  dashboardUrlFor,
} from "@/lib/dashboards";

// Dashboard membership and URL derivation now live in src/lib/dashboards.ts,
// so the reports index can answer "which assets do we monitor" from the same
// definition. The retail/-full asymmetries there are deliberate; see that file.
const hasDashboard = hasDashboardEmbed(entry.data.slug);
const dashboardUrl = dashboardUrlFor(entry.data);
---

<ReportLayout data={entry.data} hasDashboard={hasDashboard} headings={headings} dashboardUrl={dashboardUrl}>
  <Content />
</ReportLayout>
