  {
    // ⚠️ Dashboard is 11.2 DAYS STALE (backing-monitor, 2026-09-10) and carries
    // its own staleness banner. Held on the join anyway, since its report is
    // staging-only — but do not promote this tile without re-checking the feed.
    slug: "bmnr",
    asset: "bmnr",
    name: "BMNR (BitMine Immersion)",
    chain: "BitMine (NYSE: BMNR)",
