---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import { isProductionStage } from "@/lib/stage";

/**
 * The dashboard hub: TILES THAT LINK. It does not embed.
 *
 * ⚠️ THIS PAGE USED TO IFRAME EIGHTEEN DASHBOARDS AT 650px EACH, and that was
 * wrong twice over. It contradicted the owner's link-don't-embed rule
 * (2026-09-09) — the rule was applied to report pages and to DashboardEmbed's
 * default, but this page passed `embed={d.embed ?? true}` and so overrode the
 * safe default it was supposed to inherit. And it could not be checked locally:
 * every iframe pointed at `/dashboards/?asset=<slug>`, which is THIS page, so it
 * only resolved because netlify.toml proxies requests carrying `?asset=` out to
 * backing-monitor. In `npm run dev` the page nested inside itself.
 *
 * ⚠️ THE FAILURE MODE INVERTS WHEN YOU STOP EMBEDDING. A dead embed is visible
 * as a broken frame on our own page; a dead LINK is invisible until a reader
 * clicks it. So the list below is not hand-maintained any more — see the gate.
 *
 * WHICH TILES SHOW ON PRODUCTION (owner ruling, 2026-09-10): the JOIN of
 * "the asset has a production report here" AND "backing-monitor serves a live
 * dashboard". Both legs required. Two useful consequences fall out of the rule
 * rather than needing special cases:
 *   - `bmnr`'s dashboard is 11.2 days stale, and its report is staging-only, so
 *     the join drops it with no staleness carve-out.
 *   - `cusd` is live and healthy on backing-monitor but has no report at all,
 *     so it is staging-only and its tile carries no report link.
 *
 * Live-set verified with backing-monitor against their DEPLOYED site, not their
 * registry file, on 2026-09-10: 25 published slugs, 12 render-verified in a
 * browser and 13 verified as 200 + fresh feed + all axis blocks present.
 */
interface Dashboard {
  /** Report slug — the /reports/<slug> link. Omit when no report exists. */
  slug?: string;
  /** backing-monitor slug — the ?asset=<asset> link. NOT always the report slug. */
  asset: string;
  name: string;
  chain: string;
  description: string;
  category?: string;
  /** Overrides the ?asset= link. Only thBILL, which has its own repo. */
  url?: string;
  /** Production requires BOTH legs of the join. See the note above. */
  production?: boolean;
}

const allDashboards: Dashboard[] = [
