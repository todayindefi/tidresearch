const dashboards = isProductionStage
  ? allDashboards.filter((d) => d.production === true)
  : allDashboards;

const linkFor = (d: Dashboard) => d.url ?? `/dashboards/?asset=${d.asset}`;

// Stable category order; anything unlisted sorts to the end under "Other".
const ORDER = ["Stablecoin", "Yield", "RWA", "Lending", "TradFi Equity"];
const groups = ORDER.map((c) => ({
  category: c,
  items: dashboards.filter((d) => d.category === c),
})).filter((g) => g.items.length > 0);
const ungrouped = dashboards.filter((d) => !ORDER.includes(d.category ?? ""));
if (ungrouped.length) groups.push({ category: "Other", items: ungrouped });
---

<BaseLayout
  title="Dashboards | TID Research"
  description="Live on-chain backing dashboards for monitored assets — stablecoins and tokenized Treasuries."
>
  <section class="container-page py-16">
    <div class="mb-10">
      <p class="eyebrow mb-3">Live Data</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Backing Dashboards</h1>
      <p class="text-muted-foreground max-w-2xl">
        Hourly on-chain monitoring of supply, collateral, and peg health for each
        monitored asset. Dashboards open in a new tab and update independently of
        the research reports, which are authored judgements at a stated date.
      </p>
    </div>

    <div class="space-y-12">
      {
        groups.map((g) => (
          <section>
            <h2 class="eyebrow mb-4 pb-2 border-b border-border">
              {g.category} <span class="text-muted-foreground">({g.items.length})</span>
            </h2>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {g.items.map((d) => (
                <article class="border border-border bg-card p-5 flex flex-col">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <h3 class="text-lg font-bold leading-tight">{d.name}</h3>
                    {d.category && <Badge variant="outline">{d.category}</Badge>}
                  </div>
                  <p class="text-xs text-muted-foreground font-mono mb-3">{d.chain}</p>
                  <p class="text-sm text-muted-foreground mb-5 flex-1">{d.description}</p>
                  <div class="flex items-center gap-4 pt-3 border-t border-border">
                    <a
                      href={linkFor(d)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm uppercase tracking-wider text-primary hover:underline font-semibold"
                    >
                      Open dashboard ↗
                    </a>
                    {d.slug && (
                      <a
                        href={`/reports/${d.slug}`}
                        class="text-sm uppercase tracking-wider text-muted-foreground hover:underline"
                      >
                        Read report →
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
